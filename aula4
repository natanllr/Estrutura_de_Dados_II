        "class PilhaMatematica:\n",
        "    def __init__(self):\n",
        "        self.itens = []\n",
        "\n",
        "    def empilhar(self, numero):\n",
        "        self.itens.append(numero)\n",
        "\n",
        "    def desempilhar(self):\n",
        "        if not self.esta_vazia():\n",
        "            return self.itens.pop()\n",
        "        return None\n",
        "\n",
        "    def esta_vazia(self):\n",
        "        return len(self.itens) == 0\n",
        "\n",
        "    def mostrar_pilha(self):\n",
        "        if self.esta_vazia():\n",
        "            print(\"Pilha:(Vazia)\")\n",
        "        else:\n",
        "            # Exibe os elementos da pilha (da base ao topo)\n",
        "            print(f\"Pilha (base -> topo): {self.itens}\")\n",
        "\n",
        "    def esvaziar_e_somar(self):\n",
        "        soma = 0\n",
        "        # Percorre esvaziando a pilha iterativamente\n",
        "        while not self.esta_vazia():\n",
        "            soma += self.desempilhar()\n",
        "        return soma\n",
        "\n",
        "\n",
        "# --- Testando a Pilha ---\n",
        "\n",
        "pilha = PilhaMatematica()\n",
        "\n",
        "# 1. Inserindo elementos\n",
        "pilha.empilhar(10)\n",
        "pilha.empilhar(20)\n",
        "pilha.empilhar(30)\n",
        "pilha.empilhar(5)\n",
        "\n",
        "# 2. Mostrando a pilha ANTES de esvaziar\n",
        "print(\"--- Estado Inicial ---\")\n",
        "pilha.mostrar_pilha()\n",
        "\n",
        "# 3. Esvaziando e somando os elementos\n",
        "soma_total = pilha.esvaziar_e_somar()\n",
        "\n",
        "# 4. Mostrando o resultado e a pilha DEPOIS de esvaziar\n",
        "print(\"\\n--- Processando ---\")\n",
        "print(f\"Soma total dos elementos removidos: {soma_total}\")\n",
        "\n",
        "print(\"\\n--- Estado Final ---\")\n",
        "pilha.mostrar_pilha()"
