        "class Impressora:\n",
        "    def __init__(self):\n",
        "        self.fila = []\n",
        "\n",
        "    def adicionar(self, documento):\n",
        "        self.fila.append(documento)\n",
        "        print(\"Documento adicionado:\", documento)\n",
        "\n",
        "    def imprimir(self):\n",
        "        if not self.fila:\n",
        "            print(\"Não há documentos na fila.\")\n",
        "            return\n",
        "\n",
        "        documento = self.fila.pop(0)\n",
        "        print(\"Imprimindo:\", documento)\n",
        "\n",
        "    def mostrar_fila(self):\n",
        "        if not self.fila:\n",
        "            print(\"A fila está vazia.\")\n",
        "        else:\n",
        "            print(\"Fila de impressão:\")\n",
        "            for documento in self.fila:\n",
        "                print(\"-\", documento)\n",
