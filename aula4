        "class Hospital:\n",
        "    def __init__(self):\n",
        "        self.fila = []\n",
        "\n",
        "    def adicionar(self, nome):\n",
        "        self.fila.append(nome)\n",
        "        print(f\"{nome} adicionado!\")\n",
        "\n",
        "    def remover(self):\n",
        "        if not self.fila:\n",
        "            print(\"A fila está vazia.\")\n",
        "            return\n",
        "\n",
        "        atendido = self.fila.pop(0)  # Remove e retorna o primeiro da fila\n",
        "        print(f\"{atendido} foi atendido com sucesso!\")\n",
        "\n",
        "    def mostrar_fila(self):\n",
        "        if not self.fila:\n",
        "            print(\"A fila está vazia.\")\n",
        "        else:\n",
        "            print(\"Fila de Atendimento:\")\n",
        "            for nome in self.fila:\n",
        "                print(\"-\", nome)\n",
        "\n",
        "    def prioridade(self, nome):\n",
        "        self.fila.insert(0, nome)  # Insere no início da fila (posição 0)\n",
        "        print(f\"{nome} adicionado com prioridade!\")\n",
        "\n",
        "\n",
        "# --- Testando as funções ---\n",
