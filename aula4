        "from collections import deque\n",
        "\n",
        "class CallCenter:\n",
        "    def __init__(self):\n",
        "        # Utilizando deque para maior eficiência em filas\n",
        "        self.fila = deque()\n",
        "\n",
        "    def adicionar_cliente(self, nome):\n",
        "        self.fila.append(nome)\n",
        "        print(f\"-> Cliente '{nome}' entrou na fila de espera.\")\n",
        "\n",
        "    def chamar_proximo(self):\n",
        "        if self.esta_vazia():\n",
        "            print(\"Nenhum cliente na fila de espera.\")\n",
        "            return None\n",
        "\n",
        "        # Remove o primeiro cliente que entrou (início da fila)\n",
        "        atendido = self.fila.popleft()\n",
        "        print(f\"--> Chamando cliente '{atendido}' para atendimento!\")\n",
        "        return atendido\n",
        "\n",
        "    def esta_vazia(self):\n",
        "        return len(self.fila) == 0\n",
        "\n",
        "    def mostrar_fila(self):\n",
        "        if self.esta_vazia():\n",
        "            print(\"Fila atual: [ VAZIA ]\")\n",
        "        else:\n",
        "            print(f\"Fila atual (primeiro -> último): {list(self.fila)}\")\n",
        "\n",
        "\n",
        "# --- Simulando o Ciclo de Atendimento ---\n",
        "\n",
        "central = CallCenter()\n",
        "\n",
        "# 1. Clientes chegando\n",
        "print(\"--- Chegada de Clientes ---\")\n",
        "central.adicionar_cliente(\"Lucas\")\n",
