        "\n",
        "print(\"\\n--- Estado Inicial ---\")\n",
        "central.mostrar_fila()\n",
        "\n",
        "# 2. Atendendo alguns clientes e adicionando novos no meio do processo\n",
        "print(\"\\n--- Ciclo de Atendimento ---\")\n",
