        "class Desfazer:\n",
        "    def __init__(self):\n",
        "        self.pilha = []\n",
        "        self.texto = \"\"\n",
        "\n",
        "    def digitar(self, texto):\n",
        "        self.pilha.append((\"digitar\", texto))\n",
        "        self.texto += texto\n",
        "\n",
        "    def apagar(self, quantidade):\n",
        "        apagado = self.texto[-quantidade:]\n",
        "        self.pilha.append((\"apagar\", apagado))\n",
        "        self.texto = self.texto[:-quantidade]\n",
        "\n",
        "    def substituir(self, antigo, novo):\n",
        "        if antigo in self.texto:\n",
        "            self.pilha.append((\"substituir\", antigo, novo))\n",
        "            self.texto = self.texto.replace(antigo, novo, 1)\n",
        "\n",
        "    def desfazer(self):\n",
        "        if not self.pilha:\n",
        "            print(\"Não há ações para desfazer.\")\n",
        "            return\n",
        "\n",
        "        acao = self.pilha.pop()\n",
        "\n",
        "        if acao[0] == \"digitar\":\n",
        "            texto = acao[1]\n",
        "            self.texto = self.texto[:-len(texto)]\n",
        "\n",
        "        elif acao[0] == \"apagar\":\n",
        "            texto_apagado = acao[1]\n",
        "            self.texto += texto_apagado\n",
        "\n",
        "        elif acao[0] == \"substituir\":\n",
        "            antigo = acao[1]\n",
        "            novo = acao[2]\n",
        "            self.texto = self.texto.replace(novo, antigo, 1)\n",
        "\n",
        "    def mostrar(self):\n",
        "        print(\"Texto atual:\", self.texto)\n",
        "\n",
        "\n",
        "# Programa principal\n",
        "editor = Desfazer()\n",
        "\n",
        "editor.digitar(\"Olá \")\n",
        "editor.mostrar()\n",
        "\n",
        "editor.digitar(\"mundo!\")\n",
        "editor.mostrar()\n",
        "\n",
        "editor.desfazer()\n",
        "editor.mostrar()\n",
